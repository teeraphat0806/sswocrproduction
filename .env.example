# Application Configuration
LOG_LEVEL=INFO

# File Upload Configuration
MAX_FILE_SIZE_MB=20

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# API Authentication Token
# Generate a secure random token for production
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=your-secret-api-token-here

# CORS Configuration (comma-separated origins for production)
# Example: https://yourapp.com,https://app.yourapp.com
ALLOWED_ORIGINS=*

# OCR Configuration
TESSERACT_CMD=/usr/bin/tesseract
OCR_DPI=144

# OpenRouter.ai Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: OpenRouter headers for tracking and rate limits
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=Thai PDF OCR API
